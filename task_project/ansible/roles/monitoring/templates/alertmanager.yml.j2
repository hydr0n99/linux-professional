global:
  resolve_timeout: 5m

route:
  receiver: operations
  group_by: [alertname, instance]
  group_wait: 15s
  group_interval: 2m
  repeat_interval: 2h

receivers:
  - name: operations
    webhook_configs:
      - url: "http://{{ logger_ip }}:9095/alerts"
        send_resolved: true
{% if alertmanager_telegram_bot_token | length > 0 and alertmanager_telegram_chat_id | int != 0 %}
    telegram_configs:
      - bot_token: "{{ alertmanager_telegram_bot_token }}"
        chat_id: {{ alertmanager_telegram_chat_id }}
        send_resolved: true
{% endif %}
