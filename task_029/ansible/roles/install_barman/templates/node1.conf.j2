[node1]
description = "backup node1"
ssh_command = ssh postgres@{{ install_barman_primary_ip }}
conninfo = host={{ install_barman_primary_ip }} user=barman port=5432 dbname=postgres
retention_policy_mode = auto
retention_policy = RECOVERY WINDOW OF 7 days
wal_retention_policy = main
streaming_archiver=on
path_prefix = /usr/lib/postgresql/14/bin
create_slot = auto
slot_name = node1
streaming_conninfo = host={{ install_barman_primary_ip }} user=barman 
backup_method = postgres
archiver = off
